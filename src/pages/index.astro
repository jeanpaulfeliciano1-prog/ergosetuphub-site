---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import categories from '../data/categories.json';

const faqs = [
  { q: 'Do I need to buy everything at once?', a: "No. If you can only fix one thing, start with monitor height. It's the cheapest, fastest change and affects your neck and eyes the most." },
  { q: 'Is an expensive chair actually worth it?', a: 'If you sit for six or more hours a day, a chair with good adjustability and lumbar support, like the Aeron or Series 1, can be worth the money over a year or two. If budget is tight, a well-adjusted mid-range chair plus a lumbar cushion is a reasonable middle ground.' },
  { q: 'Standing desk or sitting desk?', a: 'Neither, exclusively. Most guidance points to alternating between the two through the day rather than standing all day, which brings its own fatigue.' },
];
---
<Base>
  <main>
    <div class="hero">
      <div class="wrap hg">
        <div>
          <h1>Build a home office <mark>that doesn't hurt.</mark></h1>
          <p class="sub">ErgoSetupHub is a small, independent guide to setting up a desk that supports your back, wrists and eyes, with straightforward picks across chairs, desks, monitor arms, keyboards and lighting.</p>
          <div class="cta"><a class="btn" href="#chairs">See our top picks</a><a class="btn l" href="#how">How we choose</a></div>
        </div>
        <div class="quick">
          <h5>Shop by category &middot; top pick each</h5>
          {categories.map((c) => (
            <a class="q" href={`#${c.id}`}>
              <span class="qi"><Icon id={c.id} /></span>
              <span class="qt"><b>{c.title}</b><small>Top pick: {c.products[0].name}</small></span>
              <span class="arr">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="wrap">
      {categories.map((c) => (
        <section id={c.id}>
          <div class="sh"><h2>{c.title}</h2><p>{c.lede}</p></div>
          <div class="row">
            <ProductCard {...c.products[0]} category={c.id} featured />
            <div class="minis">
              {c.products.slice(1).map((p) => <ProductCard {...p} category={c.id} />)}
            </div>
          </div>
        </section>
      ))}

      <div class="how" id="how">
        <h3>How we pick</h3>
        <p>We prioritize pieces with clear ergonomic reasoning behind them (adjustable lumbar support, proper monitor height ranges, neutral wrist angles) over whatever is trending. We link to Amazon search results so you always land on current pricing, sizes and colors.</p>
      </div>

      <div class="faq" id="faq">
        <h2>Frequently asked questions</h2>
        {faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </main>
</Base>
